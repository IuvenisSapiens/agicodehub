{
  "name": "keytik-website",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "description": "Official website for KeyTik.",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fajar-RahmadJaya/website-dev.git"
  },
  "bugs": {
    "url": "https://github.com/Fajar-RahmadJaya/website-dev/issues"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "test": "pnpm lint && pnpm build",
    "dev": "vitepress dev src",
    "build": "vitepress build src",
    "preview": "vitepress preview src",
    "optimize:images": "esr scripts/build-optimized.cjs",
    "lint": "pnpm lint:es && pnpm lint:mdl && pnpm lint:style",
    "lint:fix": "pnpm lint:es:fix && pnpm lint:style:fix",
    "lint:es": "eslint . ",
    "lint:es:fix": "eslint . --fix",
    "lint:mdl": "markdownlint \"**/*.md\" \".github/**/*.md\" --enable sentences-per-line --disable MD025 MD033",
    "lint:style": "stylelint '**/*.{styl,vue}' 'src/.vitepress/**/*.{styl,vue}'",
    "lint:style:fix": "stylelint --fix '**/*.{styl,vue}' 'src/.vitepress/**/*.{styl,vue}'"
  },
  "dependencies": {
    "@iconify-prerendered/vue-mdi": "0.28.1737398331",
    "@octokit/rest": "22.0.1",
    "@octokit/types": "18.0.0",
    "@tanstack/vue-query": "5.102.8",
    "@vueuse/core": "14.4.0",
    "axios": "1.20.0",
    "element-plus": "2.14.5",
    "eslint-plugin-n": "18.3.0",
    "eslint-plugin-promise": "7.3.0",
    "lodash.groupby": "4.6.0",
    "markdown-it": "15.0.2",
    "markdown-it-shortcode-tag": "1.1.0",
    "moment": "2.30.1",
    "pnpm": "^12.4.1",
    "sharp": "^0.35.4",
    "viewerjs": "^1.14.0",
    "vitepress-plugin-image-viewer": "^1.1.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@eslint/eslintrc": "^3.3.7",
    "@mdit/plugin-attrs": "1.3.1",
    "@mdit/plugin-figure": "1.2.1",
    "@mdit/plugin-img-lazyload": "1.1.1",
    "@mdit/plugin-img-mark": "1.1.1",
    "@mdit/plugin-img-size": "1.1.1",
    "@mdit/plugin-include": "1.1.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/gtag.js": "0.0.20",
    "@types/lodash.groupby": "4.6.9",
    "@types/markdown-it": "14.2.0",
    "@types/node": "^26.5.1",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "autoprefixer": "^10.6.0",
    "eslint": "10.10.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-vue": "10.11.0",
    "feed": "6.0.0",
    "init": "^0.1.2",
    "lint-staged": "17.5.1",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1",
    "postcss": "^8.5.28",
    "sentences-per-line": "0.5.3",
    "stylelint": "17.15.0",
    "stylelint-stylus": "1.0.0",
    "stylus": "0.64.0",
    "unplugin-element-plus": "0.11.2",
    "vite-plugin-eslint": "1.8.1",
    "vitepress": "1.5.0",
    "vitepress-plugin-tabs": "0.9.1",
    "vue": "3.5.42",
    "vue-eslint-parser": "10.4.1",
    "x-satori": "0.5.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{styl,vue}": "stylelint --fix",
    "*.{html,json}": "prettier --write"
  }
}
